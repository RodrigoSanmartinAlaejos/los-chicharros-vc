<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Solo comprueba el Javadoc de los servicios: el formato lo pone Spotless (google-java-format).
  Regla: clases y métodos públicos de las clases *Service con Javadoc (reglas técnicas, «Comentarios»).
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>

  <!-- Todo lo que no sea un fichero *Service.java queda fuera -->
  <module name="SuppressionSingleFilter">
    <property name="files" value="^(?!.*Service\.java$).*$"/>
  </module>

  <module name="TreeWalker">
    <module name="MissingJavadocType">
      <property name="scope" value="public"/>
      <property name="tokens" value="CLASS_DEF"/>
    </module>
    <module name="MissingJavadocMethod">
      <property name="scope" value="public"/>
      <property name="tokens" value="METHOD_DEF"/>
      <property name="allowMissingPropertyJavadoc" value="true"/>
    </module>
  </module>
</module>
