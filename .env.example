# Copia este fichero como .env y rellena los valores. El .env nunca se sube a Git.
# No uses el carácter $ en los valores: Docker Compose lo interpreta como una variable.
SPRING_PROFILES_ACTIVE=dev
DB_URL=
DB_USER=
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Clave de los access tokens: al menos 32 caracteres aleatorios (ver backend/README.md)
JWT_SECRET=
# Administrador inicial: se crea al arrancar si no hay ninguno. Contraseña de 12 caracteres o más
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Frontend (servidor SSR): URL de la API, entorno, dominios que atiende y proxies de confianza
API_URL=http://localhost:8080
APP_ENV=dev
NG_ALLOWED_HOSTS=localhost
TRUST_PROXY=
# Imágenes: local (disco, en backend/uploads) o cloudinary (necesita CLOUDINARY_URL, que se copia de
# «API environment variable» en el panel de Cloudinary)
IMAGE_STORAGE=local
CLOUDINARY_URL=
MAIL_API_KEY=
SENTRY_DSN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
